<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+): nothing from this app is copied to Google cloud
     backup or to a new phone during device-to-device transfer. The database
     would be unreadable anyway: its key lives in Android Keystore, which is
     never backed up or transferred. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
